# macOS / editors
.DS_Store
.vscode/
.idea/
*.swp

# logs, Node
*.log
node_modules/

# Python engine (engine/.gitignore says the same): virtualenv, ~1.4 GB of downloaded models, bytecode
engine/.venv/
engine/models/
